<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!--<arg name="map_path"/>-->
  <include file="$(find-pkg-share autoware_launch)/launch/planning_simulator.launch.xml">
    <arg name="map_path" value="/home/aw/autoware_data/maps/sample-map-planning"/>
    <arg name="vehicle_model" value="sample_vehicle"/>
    <arg name="sensor_model" value="sample_sensor_kit"/>
    <arg name="trajectory_follower_mode" value="none"/>
  </include>

  <!-- The controller is replaced by Simulink (dumb_control.slx). Publish the controller's
       control_state diagnostic so that the autonomous mode can become available. -->
  <node pkg="autoware_dummy_diag_publisher" exec="autoware_dummy_diag_publisher_node"
        name="controller_dummy_diag_publisher" output="screen">
    <param from="/workspace/docker_vnc/controller_dummy_diag.param.yaml"/>
    <param name="update_rate" value="10.0"/>
  </node>
</launch>
